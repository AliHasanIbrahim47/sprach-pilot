{
  "openapi": "3.1.0",
  "info": {
    "title": "SprachPilot API",
    "version": "0.1.0",
    "description": "Shared Zod contracts drive validation and this OpenAPI document (SP-006)."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local API"
    }
  ],
  "components": {
    "schemas": {
      "LivenessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "not_ready"]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "$ref": "#/components/schemas/CheckStatus"
              },
              "redis": {
                "$ref": "#/components/schemas/CheckStatus"
              }
            }
          },
          "failing": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DependencyName"
            }
          }
        },
        "required": ["status", "checks", "failing"]
      },
      "CheckStatus": {
        "type": "string",
        "enum": ["ok", "fail"]
      },
      "DependencyName": {
        "type": "string",
        "enum": ["database", "redis"]
      },
      "RegisterAcceptedResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["accepted"]
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["status", "message"]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 500,
            "format": "uri"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string",
            "maxLength": 2000
          },
          "instance": {
            "type": "string",
            "maxLength": 500
          },
          "requestId": {
            "type": "string",
            "maxLength": 100
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "maxItems": 100
          }
        },
        "required": ["type", "title", "status"]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 200
          },
          "code": {
            "type": "string",
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["field", "code", "message"]
      },
      "RegisterBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "description": "Normalized email address",
            "example": "learner@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Password (min 10 characters)",
            "example": "ChangeMe!Learner1"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Public display name",
            "example": "Demo Learner"
          },
          "acceptedTerms": {
            "type": "boolean",
            "enum": [true],
            "description": "Must accept Terms and Privacy Policy"
          }
        },
        "required": ["email", "password", "displayName", "acceptedTerms"]
      },
      "LoginSuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["authenticated"]
          },
          "user": {
            "$ref": "#/components/schemas/LoginUser"
          }
        },
        "required": ["status", "user"]
      },
      "LoginUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": ["id", "displayName", "emailVerified"]
      },
      "LoginBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "description": "Normalized email address",
            "example": "learner@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Account password",
            "example": "ChangeMe!Learner1"
          }
        },
        "required": ["email", "password"]
      },
      "RefreshSuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["refreshed"]
          }
        },
        "required": ["status"]
      },
      "SessionListResponse": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthSession"
            }
          }
        },
        "required": ["sessions"]
      },
      "AuthSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Stable session family id. Matches the access token sid.",
            "example": "018f1c3a-7b2e-7c4a-8d11-6a0e5b9c4d22"
          },
          "current": {
            "type": "boolean",
            "description": "True for the session that presented this request"
          },
          "userAgent": {
            "type": ["string", "null"],
            "description": "Device user agent captured at login"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the device session was opened"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the refresh token was last rotated"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the current refresh token expires"
          }
        },
        "required": ["id", "current", "userAgent", "createdAt", "lastUsedAt", "expiresAt"]
      },
      "VerifyEmailResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["verified"]
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["status", "message"]
      },
      "ResendVerificationBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "description": "Account email. Ignored when a session cookie is present.",
            "example": "learner@example.com"
          }
        }
      },
      "PasswordForgotBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "description": "Normalized email address",
            "example": "learner@example.com"
          }
        },
        "required": ["email"]
      },
      "PasswordResetResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["reset"]
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["status", "message"]
      },
      "PasswordResetBody": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256,
            "description": "Single-use reset token"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "New password (min 10 characters)"
          }
        },
        "required": ["token", "password"]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "locale": {
            "type": "string",
            "enum": ["en", "de", "ar", "uk", "tr"]
          },
          "hasPassword": {
            "type": "boolean"
          },
          "googleLinked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "displayName",
          "email",
          "emailVerified",
          "locale",
          "hasPassword",
          "googleLinked"
        ]
      },
      "OAuthCallbackResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OAuthAuthenticatedResponse"
          },
          {
            "$ref": "#/components/schemas/OAuthLinkRequiredResponse"
          }
        ],
        "discriminator": {
          "propertyName": "status",
          "mapping": {
            "authenticated": "#/components/schemas/OAuthAuthenticatedResponse",
            "link_required": "#/components/schemas/OAuthLinkRequiredResponse"
          }
        }
      },
      "OAuthAuthenticatedResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["authenticated"]
          },
          "needsOnboarding": {
            "type": "boolean"
          },
          "locale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "emailVerified": {
                "type": "boolean"
              }
            },
            "required": ["id", "displayName", "emailVerified"]
          }
        },
        "required": ["status", "needsOnboarding", "locale", "user"]
      },
      "OAuthLinkRequiredResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["link_required"]
          },
          "linkToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "locale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8
          }
        },
        "required": ["status", "linkToken", "email", "locale"]
      },
      "OAuthGoogleCallbackBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": ["code", "state"]
      },
      "OAuthGoogleLinkBody": {
        "type": "object",
        "properties": {
          "linkToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["linkToken", "password"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["Health"],
        "summary": "Liveness probe",
        "description": "Returns 200 when the process is running.",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": ["Health"],
        "summary": "Readiness probe",
        "description": "Checks database and Redis. Returns 503 when a dependency is down.",
        "responses": {
          "200": {
            "description": "All dependencies are healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "One or more dependencies are unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register with email and password",
        "description": "Creates an account and asks the caller to verify their email. The response is the same when the email is already registered; that account receives a notice instead of a second user. Passwords are checked against a bundled common-password list.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Registration accepted. Check email to verify the account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterAcceptedResponse"
                },
                "example": {
                  "status": "accepted",
                  "message": "Check your email to verify your account."
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, including a password that is too common",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Registration is disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in with email and password",
        "description": "Verifies credentials. Wrong email and wrong password return the same error. A successful login sets httpOnly access and refresh cookies and does not return token strings. After 5 failures in 15 minutes for an email and IP pair, further attempts return 429.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credentials matched",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Email or password is incorrect",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts for this email and IP",
            "headers": {
              "Retry-After": {
                "description": "Seconds until another attempt is allowed",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out",
        "description": "Revokes the current session family and clears the access and refresh cookies. The response is 204 even when no session cookie was sent.",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotate the refresh token",
        "description": "Reads the refresh cookie, issues a new access token and refresh token, and invalidates the presented refresh token. Presenting a refresh token that was already rotated revokes the whole session family and returns 401.",
        "responses": {
          "200": {
            "description": "Cookies rotated. The body does not contain token strings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshSuccessResponse"
                },
                "example": {
                  "status": "refreshed"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked, or reused refresh token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sessions": {
      "get": {
        "tags": ["Auth"],
        "summary": "List active sessions",
        "description": "Returns the caller's live device sessions. Requires a valid access-token cookie.",
        "responses": {
          "200": {
            "description": "Active sessions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired access token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sessions/{id}": {
      "delete": {
        "tags": ["Auth"],
        "summary": "Revoke a session",
        "description": "Revokes one device session family. The other device is rejected at its next refresh. Requires a valid access-token cookie.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Session family id"
            },
            "required": true,
            "description": "Session family id",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "401": {
            "description": "Missing or expired access token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No session with that id belongs to the caller",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/verify": {
      "get": {
        "tags": ["Auth"],
        "summary": "Verify an email address",
        "description": "Consumes a single-use verification token. A token that was already used returns 409. Expired and unknown tokens return 400. The raw token is not stored.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 256,
              "description": "Single-use verification token"
            },
            "required": true,
            "description": "Single-use verification token",
            "name": "token",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Email verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResponse"
                },
                "example": {
                  "status": "verified",
                  "message": "Your email is verified."
                }
              }
            }
          },
          "400": {
            "description": "Token is missing, expired, or invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Link already used",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/verify/resend": {
      "post": {
        "tags": ["Auth"],
        "summary": "Resend a verification email",
        "description": "Queues another verification email when the account exists and is unverified, up to 3 per address per hour. The response does not reveal whether the email exists, is already verified, or was rate limited. A session cookie selects the signed-in account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationBody"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterAcceptedResponse"
                },
                "example": {
                  "status": "accepted",
                  "message": "If an account exists for that email, we sent a verification link."
                }
              }
            }
          },
          "400": {
            "description": "Problem Details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/password/forgot": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request a password reset",
        "description": "Always returns the same confirmation. A reset email is queued only when the account exists and the address is under the hourly limit of 3.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordForgotBody"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterAcceptedResponse"
                },
                "example": {
                  "status": "accepted",
                  "message": "If an account exists for that email, we sent password reset instructions."
                }
              }
            }
          },
          "400": {
            "description": "Problem Details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/password/reset": {
      "post": {
        "tags": ["Auth"],
        "summary": "Choose a new password",
        "description": "Consumes a single-use reset token, stores a new password hash, and revokes every existing session for that user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated and sessions revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetResponse"
                },
                "example": {
                  "status": "reset",
                  "message": "Your password has been reset. Sign in with the new password."
                }
              }
            }
          },
          "400": {
            "description": "Token is invalid or expired, or the password is too common",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }

// SprachPilot base schema (SP-005).
// Naming: camelCase in Prisma Client, snake_case in PostgreSQL via @map / @@map.
// PII columns are marked with `/// @pii` for GDPR export/deletion (SP-019).
// Indexes: every foreign key and frequent filter columns are indexed (documented below).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) URL for migrate / introspect. Same as DATABASE_URL in local
  // docker-compose; in production use the migrator role + direct CloudNativePG host.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  learner
  volunteer
  organizer
  content_editor
  moderator
  admin

  @@map("user_role")
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("cefr_level")
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// @pii — store normalized (lowercase, trimmed); uniqueness is case-sensitive at DB level
  email String @unique

  /// @pii — argon2id hash; never log
  passwordHash String @map("password_hash")

  /// @pii
  displayName String @map("display_name")

  role UserRole @default(learner)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  profile        Profile?
  auditLogs      AuditLog[]      @relation("AuditActor")
  consentRecords ConsentRecord[]
  sessions       Session[]

  // Filter: active users by role; soft-delete exclusion uses deleted_at IS NULL
  @@index([role], map: "users_role_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model Profile {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @pii
  nativeLanguages String[] @default([]) @map("native_languages")

  uiLocale String @default("en") @map("ui_locale")

  cefrLevel CefrLevel? @map("cefr_level")

  /// Learning goals (work, bureaucracy, health, housing, social, exam, …)
  goals String[] @default([])

  /// @pii — city label for display; precise geo arrives in SP-047
  cityName String? @map("city_name")

  cityId String? @map("city_id")

  timezone String @default("Europe/Berlin")

  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)

  /// @pii — public object-storage key/URL once uploads exist (SP-018)
  avatarUrl String? @map("avatar_url")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  // FK user_id already unique-indexed; filter columns for recommendations
  @@index([cefrLevel], map: "profiles_cefr_level_idx")
  @@index([cityId], map: "profiles_city_id_idx")
  @@index([deletedAt], map: "profiles_deleted_at_idx")
  @@map("profiles")
}

/// Terms and Privacy acceptance captured at registration (SP-012).
/// One row per policy so later GDPR export can address each document.
model ConsentRecord {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Policy identifier, e.g. `terms` or `privacy`.
  policy  String
  version String

  acceptedAt DateTime @map("accepted_at") @db.Timestamptz(3)

  /// @pii — HMAC-SHA256 of the client IP; never store the raw address
  ipHash String @map("ip_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId], map: "consent_records_user_id_idx")
  @@map("consent_records")
}

/// Refresh-token session (SP-013).
/// The live row for a device has `rotated_at` and `revoked_at` null.
/// `family_id` stays stable across rotations and is the access-token `sid`.
/// Presenting a row that already has `rotated_at` revokes every row in that family.
model Session {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId String @map("family_id") @db.Uuid

  /// HMAC-SHA256 of the refresh token. The raw token is never stored.
  refreshTokenHash String @unique @map("refresh_token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// logout | revoked | reuse
  revokedReason String? @map("revoked_reason")

  /// Set when this refresh token was replaced. A later presentation is reuse.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)

  /// @pii — truncated User-Agent for the device list
  userAgent String? @map("user_agent") @db.VarChar(256)

  /// @pii — HMAC of the client IP captured when the session was opened
  ipHash String? @map("ip_hash")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @map("last_used_at") @db.Timestamptz(3)

  @@index([userId, rotatedAt], map: "sessions_user_id_rotated_at_idx")
  @@index([familyId], map: "sessions_family_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

/// Immutable admin-action trail. Soft delete is intentionally omitted.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// Structured before/after payload (roles, fields changed, …)
  metadata Json @default("{}")

  /// @pii — hashed client IP when available (never store raw IP)
  ipHash String? @map("ip_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // FK actor_id + frequent filters for admin audit views
  @@index([actorId], map: "audit_logs_actor_id_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_idx")
  @@index([action], map: "audit_logs_action_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

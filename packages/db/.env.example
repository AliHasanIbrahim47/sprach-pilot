# Copy to packages/db/.env for local Prisma CLI (or export from the shell).
# App runtimes (API/worker) use their own env; keep values in sync with SP-007 compose.

# Application role — no superuser / CREATEDB. Used by API and worker at runtime.
DATABASE_URL=postgresql://sprachpilot:sprachpilot@localhost:5432/sprachpilot?schema=public

# Migrator role — used by prisma migrate (direct, non-pooled). Locally same as DATABASE_URL;
# in staging/prod use a dedicated migrator user (see README).
DIRECT_URL=postgresql://sprachpilot:sprachpilot@localhost:5432/sprachpilot?schema=public

# Optional separate DB for `pnpm db:drift-check` / migrate shadow DB in CI.
# SHADOW_DATABASE_URL=postgresql://sprachpilot:sprachpilot@localhost:5432/sprachpilot_shadow?schema=public

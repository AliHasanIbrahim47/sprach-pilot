# @sprachpilot/web — copy to apps/web/.env.local (Next.js loads .env*)
# Format: KEY=value  # default | secret? | public?
#
# NEXT_PUBLIC_* is inlined into the client bundle — never put secrets there.
# Server-only vars (no NEXT_PUBLIC_ prefix) stay on the server (AC-3).

# --- Public (client-safe) ---
NEXT_PUBLIC_APP_NAME=SprachPilot      # default: SprachPilot ; public

# --- Server-only ---
API_BASE_URL=http://localhost:3001    # default: http://localhost:3001 ; server-only
FEATURE_REGISTRATION_ENABLED=true     # default: true ; server-only

# Google OAuth (optional until SP-015; server-only secrets)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=         # secret

# Must match the API value when set, so login lockout uses the visitor IP. secret
# INTERNAL_API_SECRET=dev-only-change-this-internal-secret

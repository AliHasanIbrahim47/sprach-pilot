PORT=3001
DATABASE_URL=postgresql://sprachpilot:sprachpilot@localhost:5432/sprachpilot?schema=public
REDIS_URL=redis://localhost:6379
JSON_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=25000
# Optional. Docs are on by default outside production; set true to force on in production.
# ENABLE_API_DOCS=true

# S3-compatible storage (SeaweedFS from pnpm infra:up)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sprachpilot
S3_SECRET_ACCESS_KEY=sprachpilotsecret
S3_BUCKET=sprachpilot-dev
S3_FORCE_PATH_STYLE=true

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

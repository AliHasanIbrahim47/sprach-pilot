# @sprachpilot/api — copy to apps/api/.env
# Format: KEY=value  # default | secret?
# Secrets must never be committed. Values below are local-dev placeholders only.

# --- Core (required) ---
NODE_ENV=development                  # default: development
PORT=3001                             # default: 3001
DATABASE_URL=postgresql://sprachpilot:sprachpilot@localhost:5432/sprachpilot?schema=public  # secret
REDIS_URL=redis://localhost:6379      # secret (auth string if present)
JSON_BODY_LIMIT=1mb                   # default: 1mb
SHUTDOWN_TIMEOUT_MS=25000             # default: 25000

# Optional. Docs on by default outside production; set true to force on in production.
# ENABLE_API_DOCS=true

# --- S3-compatible storage (required; SeaweedFS via pnpm infra:up) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sprachpilot          # secret
S3_SECRET_ACCESS_KEY=sprachpilotsecret  # secret
S3_BUCKET=sprachpilot-dev
S3_FORCE_PATH_STYLE=true              # default: true

# --- SMTP / Mailpit (required host+port) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false                     # default: false
SMTP_USER=                            # secret when set
SMTP_PASS=                            # secret when set
WEB_PUBLIC_URL=http://localhost:3000  # links inside verification and reset emails

# --- JWT (SP-013; local-dev key only — generate a new one outside this repo) ---
# Active Ed25519 key. JWT_ACTIVE_KID must match an entry in JWT_PUBLIC_KEYS.
JWT_ACTIVE_KID=local-dev
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEILeSL+go0sAV+fxz9BnmSVqztp5F9Cganhb+P5S9B73s\n-----END PRIVATE KEY-----"  # secret
# JSON array of public keys. Keep retired keys here during rotation.
JWT_PUBLIC_KEYS='[{"kid":"local-dev","pem":"-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAwUtWX075tnJtpfy7YWoXjvhCxV251yY42rvApnJGaRk=\n-----END PUBLIC KEY-----"}]'
# HMAC pepper for refresh-token hashes. secret
JWT_REFRESH_PEPPER=dev-only-change-this-refresh-pepper
# Parent domain when web and API are on sibling subdomains. Omit for host-only cookies.
# COOKIE_DOMAIN=sprachpilot.test

# --- Google OAuth (optional until SP-015; secrets when set) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# FEATURE_GOOGLE_OAUTH=false

# --- AI services (defaults for local stub/local mode) ---
AI_MODE=stub                          # stub | local ; default: stub
ML_SERVICE_URL=http://localhost:8081
OLLAMA_URL=http://localhost:11434
LIBRETRANSLATE_URL=http://localhost:5000
LANGUAGETOOL_URL=http://localhost:8010

# --- Feature flags ---
FEATURE_REGISTRATION_ENABLED=true     # default: true
FEATURE_GOOGLE_OAUTH=false            # default: false; requires Google OAuth credentials

# HMAC pepper for client IP hashes stored with consent and login lockout. secret
IP_HASH_SECRET=dev-only-change-this-ip-hash-secret
# Shared with the web app so it can forward the real client IP. secret; optional
# INTERNAL_API_SECRET=dev-only-change-this-internal-secret

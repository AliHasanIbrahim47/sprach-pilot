{
  "name": "sprachpilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --ui=stream --filter=@sprachpilot/web --filter=@sprachpilot/api --filter=@sprachpilot/worker",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run type-check",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "node ./scripts/ensure-pnpm-native.mjs && husky",
    "db:migrate:dev": "pnpm --filter @sprachpilot/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @sprachpilot/db db:migrate:deploy",
    "db:seed": "pnpm --filter @sprachpilot/db db:seed",
    "db:studio": "pnpm --filter @sprachpilot/db db:studio",
    "db:reset": "pnpm --filter @sprachpilot/db db:reset",
    "db:drift-check": "pnpm --filter @sprachpilot/db db:drift-check",
    "openapi:generate": "pnpm --filter @sprachpilot/shared openapi:generate",
    "infra:up": "bash scripts/infra.sh up",
    "infra:down": "bash scripts/infra.sh down",
    "infra:reset": "bash scripts/infra.sh reset"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@sprachpilot/config": "workspace:*",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "turbo": "2.11.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@swc/core",
      "@parcel/watcher"
    ]
  }
}

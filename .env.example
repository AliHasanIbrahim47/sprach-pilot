# Dev-only credentials for local docker-compose (SP-007). Never reuse elsewhere.
# App-specific copies live in apps/*/.env.example (SP-008). Keep values in sync.

# Postgres
DATABASE_URL=postgresql://sprachpilot:sprachpilot@localhost:5432/sprachpilot?schema=public
DIRECT_URL=postgresql://sprachpilot:sprachpilot@localhost:5432/sprachpilot?schema=public
SHADOW_DATABASE_URL=postgresql://sprachpilot:sprachpilot@localhost:5432/sprachpilot_shadow?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (SeaweedFS; replaces MinIO for local DX)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sprachpilot
S3_SECRET_ACCESS_KEY=sprachpilotsecret
S3_BUCKET=sprachpilot-dev
S3_FORCE_PATH_STYLE=true

# Mailpit (SMTP catcher)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SprachPilot <no-reply@sprachpilot.local>
MAILPIT_UI=http://localhost:8025
WEB_PUBLIC_URL=http://localhost:3000

# JWT (SP-013). Copy the key block from apps/api/.env.example. Local-dev key only.
# JWT_ACTIVE_KID=local-dev
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEYS=
# JWT_REFRESH_PEPPER=dev-only-change-this-refresh-pepper

# HMAC pepper for consent IP hashes and login lockout (required by the API)
IP_HASH_SECRET=dev-only-change-this-ip-hash-secret
# INTERNAL_API_SECRET=dev-only-change-this-internal-secret

# Google OAuth (optional; enable with FEATURE_GOOGLE_OAUTH=true)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# AI services (no paid API keys)
AI_MODE=stub
ML_SERVICE_URL=http://localhost:8081
OLLAMA_URL=http://localhost:11434
LIBRETRANSLATE_URL=http://localhost:5000
LANGUAGETOOL_URL=http://localhost:8010

# Feature flags
FEATURE_REGISTRATION_ENABLED=true
FEATURE_GOOGLE_OAUTH=false

# Observability profile (pnpm infra:up -- --profile observability)
# Grafana: http://localhost:3002  (admin / admin)
# Prometheus: http://localhost:9090
